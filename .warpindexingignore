# =====================================
# CURSOR FULL ACCESS CONFIGURATION
# =====================================
# This file gives Cursor AI complete access to ALL files
# while .gitignore still protects sensitive files from GitHub
#
# STRATEGY: Use negation (!) to explicitly INCLUDE everything
# that .gitignore normally excludes
# =====================================

# INCLUDE ALL SENSITIVE FILES FOR CURSOR
# (These are still protected from GitHub by .gitignore)

# Include ALL environment and config files
!.env
!.env.*
!*.env
!config/secrets.*
!config/local.*

# Include ALL API keys and credentials
!**/secrets/**
!**/credentials/**
!*.key
!*.pem
!*.cert
!*.crt

# Include ALL logs for debugging
!logs/**
!*.log
!log/**

# Include ALL build artifacts
!dist/**
!build/**
!*.pyc
!__pycache__/**
!.pytest_cache/**
!*.egg-info/**

# Include ALL database files
!*.db
!*.sqlite
!*.sqlite3
!*.db-journal

# Include ALL data directories
!data/**
!artifacts/**
!models/**
!embeddings/**
!index/**

# Include ALL test and coverage files
!htmlcov/**
!.coverage
!coverage.*
!*.cover

# Include ALL virtual environments (for context)
!venv/**
!env/**
!.venv/**

# Include ALL IDE settings
!.vscode/**
!.idea/**

# Include ALL OS generated files
!.DS_Store
!Thumbs.db
!desktop.ini

# Include ALL Jupyter checkpoints
!.ipynb_checkpoints/**

# Include ALL package locks and dependencies
!package-lock.json
!yarn.lock
!Pipfile.lock
!poetry.lock

# =====================================
# MINIMAL EXCLUSIONS (only truly useless for AI)
# =====================================

# Only exclude large binary files that Cursor can't read
*.exe
*.dll
*.so
*.dylib
*.bin
*.iso
*.dmg

# Exclude large media files
*.mp4
*.mov
*.avi
*.mkv
*.mp3
*.wav
*.flac

# Exclude compressed archives (unless small)
*.zip
*.tar.gz
*.rar
*.7z
node_modules.tar.gz

# Exclude image files (unless needed for docs)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.ico
*.svg
# But include documentation images
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg

# =====================================
# RESULT:
# - GitHub: Ignores sensitive files (via .gitignore)
# - Cursor: Sees EVERYTHING except large binaries
# - You get: Full AI assistance with complete context
#
# WARNING: Cursor will have access to your secrets!
# This is intentional for dev assistance.
# Be careful when sharing screenshots!
# =====================================
