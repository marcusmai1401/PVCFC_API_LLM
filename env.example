# =====================================
# PVCFC RAG API - Environment Variables
# =====================================
# Copy this file to .env and fill in your values
# WARNING: NEVER commit the .env file to version control

# Application Configuration
APP_ENV=local
API_PORT=8000
LOG_LEVEL=INFO

# Version info (will be overridden by CI/CD in production)
VERSION=0.1.0-dev
COMMIT_SHA=unknown

# =====================================
# LLM Provider Configuration
# =====================================
# Main provider for heavy tier (high quality responses)
# Options: openai, gemini, none
LLM_PROVIDER=none

# Default tier to use (light for dev/test, heavy for production)
# Options: light, heavy
LLM_TIER=light

# Optional: Different provider for light tier (if not set, uses LLM_PROVIDER)
# Use case: Use expensive Gemini for heavy, cheap OpenAI for light
LLM_LIGHT_PROVIDER=

# Model names for each tier
# Light tier examples:
#   OpenAI: gpt-4o-mini, gpt-3.5-turbo
#   Gemini: gemini-2.5-flash, gemini-2.0-flash-exp
LLM_MODEL_LIGHT=

# Heavy tier examples:
#   OpenAI: gpt-4o, gpt-4-turbo, o1-preview
#   Gemini: gemini-2.5-pro, gemini-1.5-pro
LLM_MODEL_HEAVY=

# =====================================
# API Keys (only include what you use)
# =====================================
# OpenAI Configuration
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini Configuration
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# =====================================
# Embedding Configuration (Phase 2+)
# =====================================
# Provider for vector embeddings
# Options: openai, local, none
EMBEDDING_PROVIDER=none

# Optional alias for embedding provider (for clarity in logs)
EMBEDDING_LLM=

# Embedding model examples:
#   OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
#   Local: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=

# =====================================
# Example Configurations
# =====================================
# Example 1: Development with OpenAI only
# LLM_PROVIDER=openai
# LLM_TIER=light
# LLM_MODEL_LIGHT=gpt-4o-mini
# LLM_MODEL_HEAVY=gpt-4o
# OPENAI_API_KEY=sk-...
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# Example 2: Production with mixed providers
# LLM_PROVIDER=gemini           # Heavy tier uses Gemini
# LLM_LIGHT_PROVIDER=openai     # Light tier uses OpenAI
# LLM_TIER=heavy                # Default to heavy in production
# LLM_MODEL_LIGHT=gpt-4o-mini
# LLM_MODEL_HEAVY=gemini-2.5-pro
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AI...
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-large

# Example 3: Cost-optimized with Gemini Flash
# LLM_PROVIDER=gemini
# LLM_TIER=light
# LLM_MODEL_LIGHT=gemini-2.5-flash
# LLM_MODEL_HEAVY=gemini-2.5-pro
# GEMINI_API_KEY=AI...
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Performance Settings
CACHE_TTL_MINUTES=10
RATE_LIMIT_PER_MINUTE=60

# Note: Additional variables for Phase 2+ will be added later:
# - Database connection strings
# - Redis configuration
# - Monitoring endpoints
# - Security keys
