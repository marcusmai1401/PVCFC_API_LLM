# =====================================
# PVCFC RAG API - Environment Variables
# =====================================
# Copy this file to .env and fill in your values
# WARNING: NEVER commit the .env file to version control

# Application Configuration
APP_ENV=local
API_PORT=8000
LOG_LEVEL=INFO

# Version info (will be overridden by CI/CD in production)
VERSION=0.1.0-dev
COMMIT_SHA=unknown

# =====================================
# LLM Provider Configuration
# =====================================
# Main provider for heavy tier (high quality responses)
# Options: openai, gemini, none
LLM_PROVIDER=none

# Default tier to use (light for dev/test, heavy for production)
# Options: light, heavy
LLM_TIER=light

# Optional: Different provider for light tier (if not set, uses LLM_PROVIDER)
# Use case: Use expensive Gemini for heavy, cheap OpenAI for light
LLM_LIGHT_PROVIDER=

# Model names for each tier
# Light tier examples:
#   OpenAI: gpt-4o-mini, gpt-3.5-turbo
#   Gemini: gemini-2.5-flash, gemini-2.0-flash-exp
LLM_MODEL_LIGHT=

# Heavy tier examples:
#   OpenAI: gpt-4o, gpt-4-turbo, o1-preview
#   Gemini: gemini-2.5-pro, gemini-1.5-pro
LLM_MODEL_HEAVY=

# =====================================
# API Keys (only include what you use)
# =====================================
# OpenAI Configuration
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini Configuration
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# =====================================
# Embedding Configuration (Phase 2+)
# =====================================
# Provider for vector embeddings
# Options: openai, gemini, local, none
EMBEDDING_PROVIDER=none

# Optional alias for embedding provider (for clarity in logs)
EMBEDDING_LLM=

# Embedding model examples:
#   OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
#   Gemini: gemini-embedding-001 (768D)
#   Local: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=

# =====================================
# Advanced Embedding Configuration
# =====================================
# Output dimension (768 is maximum for Gemini embedding-001)
EMBED_OUTPUT_DIM=768

# Batch and concurrency settings (optimized for Paid Tier 1)
EMBED_BATCH_SIZE=256
EMBED_CONCURRENCY=8
EMBED_MAX_TOKENS_PER_REQ=20000

# Rate limits (adjust based on your Google AI Studio quota)
EMBED_TPM_CAP=1000000
EMBED_RPM_CAP=3000

# Embedding task type: RETRIEVAL_DOCUMENT (for indexing) or RETRIEVAL_QUERY (for search)
EMBED_TASK=RETRIEVAL_DOCUMENT

# =====================================
# Performance Settings
# =====================================
CACHE_TTL_MINUTES=10
RATE_LIMIT_PER_MINUTE=60

# =====================================
# Phase 2 - Retrieval & Context Configuration
# =====================================
# Maximum number of context chunks to send to LLM for generation
MAX_CONTEXT=8

# Number of top candidates to keep after reranking (before selecting MAX_CONTEXT)
TOP_RERANK=20

# =====================================
# Phase 2 - Vision & Text Range Scan
# =====================================
# Enable Vision-based multimodal page selector (uses image understanding)
VISION_PAGE_SELECTOR_ENABLED=true

# Enable text-only page range scan (fallback when Vision is off)
TEXT_RANGE_SCAN_ENABLED=false

# Maximum number of PDF pages to render for vision generation
VISION_MAX_PAGES_TOTAL=24

# Page number watermark for improved citation accuracy (80-85% → 100%)
VISION_ENABLE_PAGE_WATERMARK=true
VISION_WATERMARK_POSITION=top-left
VISION_WATERMARK_SIZE_MULTIPLIER=1.0

# =====================================
# Phase 2 - Degrade Mode & Resilience
# =====================================
# Allow fallback to BM25-only retrieval when FAISS/embedding service fails
RETRIEVAL_ALLOW_BM25_ONLY_FALLBACK=true

# BM25 k value to use when in degrade mode (higher to compensate for missing FAISS)
BM25_K_WHEN_DEGRADE=80

# Rerank top N value when in degrade mode (higher for better coverage)
RERANK_TOP_N_WHEN_DEGRADE=50

# =====================================
# Phase 2 - Cache Configuration
# =====================================
# TTL for retrieval/rerank cache in minutes (LRU cache with time expiration)
RETRIEVE_CACHE_TTL_MIN=10

# =====================================
# Index Directory Configuration
# =====================================
# Directory containing BM25 and FAISS indices
INDEX_DIR=data/indexes

# =====================================
# Phase 4 - Weaviate Vector Database
# =====================================
WEAVIATE_ENABLED=true
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
WEAVIATE_USE_GRPC=true
WEAVIATE_COLLECTION=Chunk
WEAVIATE_RETRIEVAL_LIMIT=50

# =====================================
# Phase 5 - OpenSearch BM25 Configuration
# =====================================
OPENSEARCH_ENABLED=true
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=rag_chunks
OPENSEARCH_BM25_K1=1.2
OPENSEARCH_BM25_B=0.75
OPENSEARCH_TIMEOUT=10

# Optional: Authentication (leave empty if no security)
# OPENSEARCH_USER=admin
# OPENSEARCH_PASSWORD=your_password_here

# =====================================
# Hybrid Retrieval Mode Selection
# =====================================
# true: Modern Hybrid (Weaviate + OpenSearch) - PRODUCTION MODE
# false: Legacy Hybrid (FAISS + BM25 offline) - FALLBACK MODE
USE_HYBRID_MODERN=true

# =====================================
# BGE CrossEncoder Reranking (Optional)
# =====================================
# Enable BGE reranking for improved semantic ranking accuracy
# Adds ~100-400ms latency but significantly improves ranking quality
# First query: ~3-5s (model loading), subsequent queries: ~0.5s
ENABLE_BGE_RERANK=true
BGE_RERANK_CANDIDATE_LIMIT=30
BGE_RERANK_TOP_K=10
BGE_RERANK_LEVEL=chunk
BGE_RERANK_AGGREGATION=max

# =====================================
# Chain-of-Verification (CoVe)
# =====================================
# Enable CoVe verification step (reduces hallucinations but adds ~20-40s latency)
ENABLE_COVE=false

# =====================================
# Artifacts Storage Location
# =====================================
# Directory for storing ingestion artifacts, layouts, crops, tags
# Default: artifacts/ingestion_production (relative to project root)
# Production: D:\PVCFC_Artifacts (external drive for large datasets)
ARTIFACTS_DIR=artifacts/ingestion_production

# =====================================
# CAD-like Tag Extraction Configuration
# =====================================
# Enable P&ID tags extraction pipeline (Dual Pipeline Architecture)
# When enabled: Auto-detects P&ID documents and extracts instrument tags
# Default: false (disabled to avoid indexing overhead if not needed)
ENABLE_PID_TAGS=false

# Gate mode: auto (use scorer), always (force enable), never (disable)
GATE_MODE=auto

# CAD-like gate threshold (score ≥ threshold → classified as P&ID)
# Adjusted from 0.60 to 0.55 based on production testing
# Range: [0.0, 1.0], typical values: 0.50-0.70
GATE_THRESHOLD=0.55

# Gray zone threshold (boost by filename keywords if score in gray zone)
# Range: [GRAY_ZONE_LOW, GATE_THRESHOLD)
GRAY_ZONE_LOW=0.45

# Tag extraction pass threshold (triplet score ≥ threshold → valid tag)
TAG_PASS_THRESHOLD=6.0

# Suffix radius for suffix attachment (em units)
SUFFIX_RADIUS_EM=1.0

# Taggy page selection thresholds
TAGGY_MIN_REGEX_HITS=3
TAGGY_MIN_CODE_TOKENS=4

# OpenSearch tags sidecar index name (separate from rag_chunks)
TAGS_INDEX_NAME=pvcfc_pid_tags

# Enable shape-aware ROI (requires OpenCV - optional)
ENABLE_SHAPE_AWARE_ROI=false

# Lazy crop generation (true: generate on-demand, false: at ingestion)
# Recommended: true (saves disk space, ~2-5GB for large corpora)
LAZY_CROP_GENERATION=true

# =====================================
# P&ID Retrieval Enhancement (Phase 5)
# =====================================
# Enable P&ID-specific query enhancements for technical drawings
# Works with ENABLE_PID_TAGS to boost tag-based queries
ENABLE_PID_ENHANCEMENT=true

# Tag boosting factors
PID_TAG_BOOST_EXACT=10.0       # Boost for exact tag match in metadata
PID_TAG_BOOST_FUZZY=2.0        # Boost for fuzzy tag match
PID_TAG_BOOST_PROXIMITY=3.0    # Boost for tag-parameter proximity

# Fuzzy matching threshold (0-100)
PID_FUZZY_THRESHOLD=90

# Enable adaptive RRF weights based on query type
RRF_ADAPTIVE_WEIGHTS=true

# =====================================
# Smart Query Classification (Phase 1)
# =====================================
# Enable Hybrid Query Classifier (P&ID vs Technical Doc)
# Note: Current implementation requires manual query_type selection
# Auto-classification is not yet implemented
HYBRID_CLASSIFIER_ENABLED=true

# Enable LLM stage for ambiguous cases (Stage 3)
HYBRID_CLASSIFIER_USE_LLM=true

# =====================================
# Conversation Memory (Multi-turn Chat)
# =====================================
# Redis connection for session storage
REDIS_URL=redis://localhost:6379

# Optional Redis password (leave empty if no auth)
REDIS_PASSWORD=

# Conversation retention and limits
CONVERSATION_TTL_HOURS=24
MAX_TURNS_PER_CONVERSATION=50
MAX_CONVERSATION_CONTEXT_TOKENS=8000

# Summarization policy (summarize every N turns to manage context)
SUMMARIZE_EVERY_N_TURNS=8

# Optional: Use provider's native chat session (Gemini ChatSession)
# When enabled, syncs with Redis but uses provider for context management
ENABLE_PROVIDER_SESSION=false

# PII Redaction (emails, phones, IDs)
ENABLE_PII_REDACTION=true

# =====================================
# Example Configurations
# =====================================
# Example 1: Development with OpenAI only
# LLM_PROVIDER=openai
# LLM_TIER=light
# LLM_MODEL_LIGHT=gpt-4o-mini
# LLM_MODEL_HEAVY=gpt-4o
# OPENAI_API_KEY=sk-...
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# Example 2: Production with mixed providers
# LLM_PROVIDER=gemini           # Heavy tier uses Gemini
# LLM_LIGHT_PROVIDER=openai     # Light tier uses OpenAI
# LLM_TIER=heavy                # Default to heavy in production
# LLM_MODEL_LIGHT=gpt-4o-mini
# LLM_MODEL_HEAVY=gemini-2.5-pro
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AI...
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-large

# Example 3: Cost-optimized with Gemini Flash
# LLM_PROVIDER=gemini
# LLM_TIER=light
# LLM_MODEL_LIGHT=gemini-2.5-flash
# LLM_MODEL_HEAVY=gemini-2.5-pro
# GEMINI_API_KEY=AI...
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-001
